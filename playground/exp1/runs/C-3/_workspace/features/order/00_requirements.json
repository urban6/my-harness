{
  "feature": "order",
  "source": "feature.md",
  "title": "주문(Order) + 재고 차감",
  "stack": {
    "language": "Java 21",
    "framework": "Spring Boot 3.5.16 (spring-boot-starter-web, validation, data-jpa)",
    "persistence": "JPA + Hibernate, PostgreSQL",
    "migration": "Flyway (flyway-core + flyway-database-postgresql)",
    "test": "JUnit 5 + Testcontainers(PostgreSQL) + spring-boot-testcontainers",
    "testCommand": "./gradlew test",
    "skill": "spring-boot"
  },
  "scope": {
    "include": ["상품 등록·조회", "주문 생성·조회·취소·목록"],
    "exclude": ["인증·인가", "결제", "상품 수정·삭제"]
  },
  "conventions": [
    "금액(price, unitPrice, totalPrice)은 정수(원 단위)",
    "createdAt은 ISO-8601 문자열",
    "주문 상태는 ORDERED | CANCELLED",
    "오류가 여럿이면 400 → 404 → 409 순으로 먼저 해당하는 것을 반환",
    "DB 접속은 spring.datasource.url/username/password 표준 속성, 환경변수(SPRING_DATASOURCE_URL 등)로 덮어쓰기 가능. 포트는 SERVER_PORT로 덮어쓰기 가능"
  ],
  "requirements": [
    {
      "id": "R1",
      "name": "상품 등록",
      "contract": "POST /api/products {name, price, stock} → 201 + Location, 본문 = R2 응답 형태",
      "rules": ["name 필수(공백만 불가)", "price > 0", "stock ≥ 0", "위반 시 400"],
      "passes": true,
      "verifiedBy": "ProductApiTest"
    },
    {
      "id": "R2",
      "name": "상품 조회",
      "contract": "GET /api/products/{id} → 200 {id, name, price, stock}",
      "rules": ["없으면 404"],
      "passes": true,
      "verifiedBy": "ProductApiTest"
    },
    {
      "id": "R3",
      "name": "주문 생성",
      "contract": "POST /api/orders {items:[{productId, quantity}]} → 201 + Location, 본문 = R4 응답 형태(status=ORDERED)",
      "rules": ["items 1개 이상", "quantity ≥ 1", "같은 productId 중복 불가", "위반 시 400", "없는 상품 404", "재고 부족 409", "모든 항목 재고 충분할 때만 생성, 재고는 전부 차감 또는 전혀 차감 안 됨(원자성)"],
      "passes": true,
      "verifiedBy": "OrderCreateApiTest"
    },
    {
      "id": "R4",
      "name": "주문 조회",
      "contract": "GET /api/orders/{id} → 200 {id, status, totalPrice, items[{productId, quantity, unitPrice}], createdAt}",
      "rules": ["unitPrice = 주문 시점 상품 가격", "totalPrice = Σ(unitPrice × quantity)", "없으면 404"],
      "passes": true,
      "verifiedBy": "OrderQueryCancelApiTest"
    },
    {
      "id": "R5",
      "name": "주문 취소",
      "contract": "POST /api/orders/{id}/cancel → 200, 본문 = R4 응답 형태",
      "rules": ["status=CANCELLED", "주문 수량만큼 재고 복원", "이미 취소 409", "없으면 404"],
      "passes": true,
      "verifiedBy": "OrderQueryCancelApiTest"
    },
    {
      "id": "R6",
      "name": "주문 목록",
      "contract": "GET /api/orders?page&size → 200 {content[], page, size, totalElements}",
      "rules": ["content 원소 = R4 응답 형태", "page 기본 0(≥0)", "size 기본 20(1~100)", "범위 밖 400", "createdAt DESC, 같으면 id DESC"],
      "passes": true,
      "verifiedBy": "OrderListApiTest"
    },
    {
      "id": "R7",
      "name": "동시성",
      "contract": "—",
      "rules": ["재고 10 상품에 수량 1 주문 20건 동시 요청 → 정확히 10건 201, 10건 409, 최종 재고 0"],
      "passes": true,
      "verifiedBy": "OrderConcurrencyTest"
    },
    {
      "id": "R8",
      "name": "에러 포맷",
      "contract": "R1~R7의 모든 에러 응답 + 요청 본문 JSON 파싱 실패(400)",
      "rules": ["RFC 9457 Problem Details", "Content-Type: application/problem+json", "최소 필드 type·title·status·detail"],
      "passes": true,
      "verifiedBy": "ErrorFormatApiTest"
    }
  ],
  "doneCriteria": ["./gradlew test 통과", "R1~R8 각각을 검증하는 테스트 존재"]
}
